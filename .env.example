# ─── Base de datos ────────────────────────────────────────────────────────────

# Local (SQLite): apunta al archivo dev.db generado por Prisma
DATABASE_URL="file:./dev.db"

# Producción (Neon / Postgres): reemplazá con tu connection string de Neon
# DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"


# ─── Sync ─────────────────────────────────────────────────────────────────────

# Token secreto para proteger el endpoint POST /api/sync
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET_TOKEN="cambiar_por_token_secreto"

# Fuente de datos del sync: "mock" (default) o "github"
DATA_SOURCE="mock"


# ─── GitHub (solo si DATA_SOURCE=github) ─────────────────────────────────────

# Personal Access Token con permisos: read:project, read:org y issues:write
# (issues:write es necesario para postear el comentario template generado por IA)
GITHUB_TOKEN=""

# IDs de los GitHub Projects v2 (se obtienen con la query GraphQL en el README)
GITHUB_PROJECT_ID_ROADMAP=""
GITHUB_PROJECT_ID_RAP=""

# Organización de GitHub
GITHUB_ORG="cliengo"


# ─── IA (Groq) — genera título amigable y descripción del template ──────────────

# API key de Groq (https://console.groq.com/keys)
GROQ_API_KEY=""

# Modelo de Groq (opcional, default: meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_MODELO="meta-llama/llama-4-scout-17b-16e-instruct"


# ─── Corte de publicación ───────────────────────────────────────────────────────

# Solo se publican items cuyo milestone "CF DD/MM" sea >= esta fecha (YYYY-MM-DD).
# Evita hacer backfill de todo el histórico IN PROD. Default: 2026-06-29 (CF 29/06).
PUBLISH_CF_CUTOFF="2026-06-29"


# ─── Auth ─────────────────────────────────────────────────────────────────────

# Saltea el middleware de auth en desarrollo local
BYPASS_AUTH="true"
